<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>Island</AssemblyName>
    <Version>0.2.8</Version>
    <ApplicationIcon>Assets/Island.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <ProjectReference Include="../Island.Core/Island.Core.csproj" />
    <EmbeddedResource Include="Licenses/BrimDeck-Apache-2.0.txt" LogicalName="Island.BrimDeckLicense" />
  </ItemGroup>
</Project>
